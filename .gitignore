# 依赖
node_modules/

# 构建产物
dist/
# PyInstaller 的中间目录（packaging/build.bat）。注意 .gitignore 里 # 只在行首
# 才是注释，写在模式后面会被当成目录名的一部分。
build/
*.spec.bak

# Python 缓存
__pycache__/
*.py[cod]
.venv

# IDE / 编辑器
.idea/
.vscode/
*.iml

# 系统文件
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
*.tmp
.saved_web/
.scratch/
docs/
.dev/

# 用户点名的导出物（`python -m jobpilot_platform_boss.catalog export --out filters.json` 的示例名）
filters.json

# 真浏览器配置（CDP 取 __zp_stoken__ 用，动了 Chrome 就废）
.chrome_profile*/

# 职位库旧档 / 回滚副本（数据已进 data/jobpilot.db，核对后自行删）
jobs.db
jobs.db.migrated

/data/
